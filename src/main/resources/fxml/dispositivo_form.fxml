<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DispositivoFormController" spacing="18" styleClass="form-page">
    <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>
    <Label text="Registrar dispositivo" styleClass="page-title"/>
    <GridPane hgap="16" vgap="10" styleClass="content-card">
        <Label text="Nombre" GridPane.rowIndex="0" styleClass="field-label"/><TextField fx:id="nameField" promptText="Device name" GridPane.rowIndex="1"/>
        <Label text="Tipo de dispositivo" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="field-label"/><ComboBox fx:id="typeComboBox" promptText="Select type" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Marca" GridPane.rowIndex="2" styleClass="field-label"/><TextField fx:id="brandField" promptText="Brand" GridPane.rowIndex="3"/>
        <Label text="Modelo" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="field-label"/><TextField fx:id="modelField" promptText="Model" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Habitación" GridPane.rowIndex="4" styleClass="field-label"/><ComboBox fx:id="roomComboBox" promptText="No room" GridPane.rowIndex="5"/>
        <Label text="Estado" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="field-label"/><ComboBox fx:id="stateComboBox" promptText="Select state" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>
    <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: #b91c1c;"/>
    <HBox spacing="10"><Button text="Guardar" onAction="#guardar" styleClass="primary-button"/><Button text="Cancelar" onAction="#cancelar"/></HBox>
</VBox>
