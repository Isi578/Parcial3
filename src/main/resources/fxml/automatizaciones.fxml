<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AutomatizacionesController" spacing="18" styleClass="page">
    <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12"><VBox spacing="4"><Label text="Automatizaciones" styleClass="page-title"/><Label text="Define condiciones y acciones para tu hogar" styleClass="muted-text"/></VBox><HBox HBox.hgrow="ALWAYS"/><Button text="+ Crear automatización" onAction="#crearAutomatizacion" styleClass="primary-button"/></HBox>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" prefWidth="350" styleClass="content-card"><Label text="Lista de automatizaciones" styleClass="section-title"/><ListView VBox.vgrow="ALWAYS"/></VBox>
        <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="content-card"><Label text="Configuración de regla" styleClass="section-title"/><Label text="Condición" styleClass="field-label"/><Label text="Selecciona una automatización para ver su condición." styleClass="form-placeholder"/><Label text="Acciones" styleClass="field-label"/><Label text="Las acciones asociadas se mostrarán aquí." styleClass="form-placeholder"/><HBox spacing="10"><Button text="Activar" onAction="#activarAutomatizacion" styleClass="primary-button"/><Button text="Desactivar" onAction="#desactivarAutomatizacion"/></HBox></VBox>
    </HBox>
</VBox>
