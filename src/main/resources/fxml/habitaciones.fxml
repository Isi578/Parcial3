<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.HabitacionesController"
      spacing="16"
      style="-fx-background-color: #f8fafc;">

    <padding>
        <Insets top="24"
                right="30"
                bottom="24"
                left="30"/>
    </padding>

    <Label text="Rooms and Device Groups"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #0f172a;"/>

    <Label text="Use Composite to control an individual device and a complete room group through the same interface."
           wrapText="true"
           style="-fx-font-size: 13px;
                  -fx-text-fill: #475569;"/>

    <Label fx:id="totalSummaryLabel"
           text="Composite summary"
           wrapText="true"
           style="-fx-font-size: 14px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1e293b;"/>

    <Label fx:id="feedbackLabel"
           text="Ready."
           wrapText="true"
           style="-fx-font-size: 13px;
                  -fx-text-fill: #047857;"/>

    <VBox spacing="8"
          style="-fx-background-color: white;
                 -fx-padding: 14;
                 -fx-background-radius: 8;
                 -fx-border-color: #e2e8f0;
                 -fx-border-radius: 8;">
        <Label text="Room Administration"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <ListView fx:id="roomsListView"
                  prefHeight="120"
                  style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1;"/>
        <HBox spacing="10">
            <Button text="Add Room" onAction="#addRoom"/>
            <Button text="Edit Selected" onAction="#editSelectedRoom"/>
            <Button text="Delete Selected" onAction="#deleteSelectedRoom"/>
            <Button text="Refresh" onAction="#refreshRooms"/>
        </HBox>
    </VBox>

    <Separator/>

    <GridPane hgap="16"
              vgap="10"
              VBox.vgrow="ALWAYS">

        <columnConstraints>
            <ColumnConstraints percentWidth="35"/>
            <ColumnConstraints percentWidth="65"/>
        </columnConstraints>

        <VBox spacing="8"
              GridPane.columnIndex="0"
              GridPane.rowIndex="0">

            <Label text="Composite Groups"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #0f172a;"/>

            <ListView fx:id="groupsListView"
                      prefHeight="390"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-radius: 8;
                             -fx-border-radius: 8;
                             -fx-border-color: #cbd5e1;"/>

        </VBox>

        <VBox spacing="8"
              GridPane.columnIndex="1"
              GridPane.rowIndex="0">

            <Label fx:id="selectedGroupLabel"
                   text="No group selected."
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #0f172a;"/>

            <Label fx:id="groupSummaryLabel"
                   text="Select a group to inspect its devices."
                   wrapText="true"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #475569;"/>

            <ListView fx:id="componentsListView"
                      prefHeight="330"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-radius: 8;
                             -fx-border-radius: 8;
                             -fx-border-color: #cbd5e1;"/>

            <HBox spacing="10">

                <Button fx:id="turnOnGroupButton"
                        text="Turn On Group"
                        onAction="#turnOnSelectedGroup"
                        style="-fx-background-color: #16a34a;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

                <Button fx:id="turnOffGroupButton"
                        text="Turn Off Group"
                        onAction="#turnOffSelectedGroup"
                        style="-fx-background-color: #dc2626;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

                <Button text="Rebuild Groups"
                        onAction="#refreshGroups"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

            </HBox>

        </VBox>

    </GridPane>

    <VBox spacing="8"
          style="-fx-background-color: white;
                 -fx-padding: 14;
                 -fx-background-radius: 8;
                 -fx-border-color: #e2e8f0;
                 -fx-border-radius: 8;">

        <Label text="Composite Demonstration"
               style="-fx-font-size: 15px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #0f172a;"/>

        <Label text="DispositivoIndividual is the leaf. GrupoDispositivos is the composite. Both implement ComponenteHogar and accept turnOn or turnOff."
               wrapText="true"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #334155;"/>

    </VBox>

</VBox>
