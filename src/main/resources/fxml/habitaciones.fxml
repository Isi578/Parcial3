<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HabitacionesController" spacing="18" styleClass="page">
    <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12"><VBox spacing="4"><Label text="Habitaciones" styleClass="page-title"/><Label text="Organiza los espacios y dispositivos asociados" styleClass="muted-text"/></VBox><HBox HBox.hgrow="ALWAYS"/><Button text="+ Registrar habitación" onAction="#registrarHabitacion" styleClass="primary-button"/></HBox>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" prefWidth="260" styleClass="content-card"><Label text="Lista de habitaciones" styleClass="section-title"/><ListView VBox.vgrow="ALWAYS"/></VBox>
        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="content-card"><HBox spacing="10"><Label text="Dispositivos asociados" styleClass="section-title" HBox.hgrow="ALWAYS"/><Button text="Consultar" onAction="#consultarDispositivos"/><Button text="Editar" onAction="#editarHabitacion"/><Button text="Eliminar" onAction="#eliminarHabitacion" styleClass="danger-button"/></HBox><TableView VBox.vgrow="ALWAYS"><columns><TableColumn text="Dispositivo" prefWidth="190"/><TableColumn text="Tipo" prefWidth="140"/><TableColumn text="Estado" prefWidth="130"/></columns></TableView></VBox>
    </HBox>
</VBox>
