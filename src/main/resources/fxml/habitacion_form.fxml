<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HabitacionFormController" spacing="16" styleClass="form-page">
    <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>
    <Label text="Registrar habitación" styleClass="page-title"/>
    <VBox spacing="10" maxWidth="680" styleClass="content-card">
        <Label text="Name" styleClass="field-label"/><TextField fx:id="nameField" promptText="e.g. Living room"/>
        <Label text="Description" styleClass="field-label"/><TextArea fx:id="descriptionField" promptText="Describe this room" prefRowCount="4" wrapText="true"/>
    </VBox>
    <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: #b91c1c;"/>
    <HBox spacing="10"><Button text="Guardar" onAction="#guardar" styleClass="primary-button"/><Button text="Cancelar" onAction="#cancelar"/></HBox>
</VBox>
