<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ConfiguracionController"
      spacing="18"
      style="-fx-background-color: #f8fafc;">

    <padding>
        <Insets top="24"
                right="30"
                bottom="24"
                left="30"/>
    </padding>

    <Label text="Home Settings"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #0f172a;"/>

    <Label text="Update the shared configuration used by Dashboard, Notifications and future automation rules."
           wrapText="true"
           style="-fx-font-size: 13px;
                  -fx-text-fill: #475569;"/>

    <Label fx:id="feedbackLabel"
           text="Ready."
           wrapText="true"
           style="-fx-font-size: 13px;
                  -fx-text-fill: #047857;"/>

    <Separator/>

    <GridPane hgap="16"
              vgap="16"
              maxWidth="760">

        <columnConstraints>
            <ColumnConstraints minWidth="210"
                               prefWidth="230"/>
            <ColumnConstraints minWidth="350"
                               prefWidth="480"/>
        </columnConstraints>

        <Label text="Home name"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"
               style="-fx-font-weight: bold;
                      -fx-text-fill: #334155;"/>

        <TextField fx:id="homeNameField"
                   promptText="My Smart Home"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Address"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"
               style="-fx-font-weight: bold;
                      -fx-text-fill: #334155;"/>

        <TextField fx:id="addressField"
                   promptText="Home address"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Temperature unit"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"
               style="-fx-font-weight: bold;
                      -fx-text-fill: #334155;"/>

        <ComboBox fx:id="temperatureUnitComboBox"
                  prefWidth="220"
                  promptText="Select unit"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="2"/>

        <Label text="Notifications"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"
               style="-fx-font-weight: bold;
                      -fx-text-fill: #334155;"/>

        <CheckBox fx:id="notificationsEnabledCheckBox"
                  text="Enable notification messages"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="3"/>

        <Label text="Energy saving"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"
               style="-fx-font-weight: bold;
                      -fx-text-fill: #334155;"/>

        <CheckBox fx:id="energySavingEnabledCheckBox"
                  text="Enable energy-saving preference"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="4"/>

    </GridPane>

    <HBox spacing="10">

        <Button text="Save Configuration"
                onAction="#saveConfiguration"
                style="-fx-background-color: #16a34a;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;"/>

        <Button text="Reload"
                onAction="#reloadConfiguration"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;"/>

        <Button text="Restore Defaults"
                onAction="#restoreDefaultConfiguration"
                style="-fx-background-color: #d97706;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;"/>

    </HBox>

    <Separator/>

    <VBox spacing="10"
          style="-fx-background-color: white;
                 -fx-padding: 18;
                 -fx-background-radius: 8;
                 -fx-border-color: #e2e8f0;
                 -fx-border-radius: 8;">

        <Label text="Shared Configuration Summary"
               style="-fx-font-size: 16px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #0f172a;"/>

        <Label fx:id="configurationSummaryLabel"
               text="Configuration summary"
               wrapText="true"
               style="-fx-font-size: 13px;
                      -fx-text-fill: #334155;"/>

        <Label text="Singleton verification: all application screens read the same ConfiguracionHogar instance."
               wrapText="true"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #64748b;"/>

    </VBox>

</VBox>