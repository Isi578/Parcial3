<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ConfiguracionController" spacing="18" styleClass="page">
    <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>
    <VBox spacing="4"><Label text="Configuración" styleClass="page-title"/><Label text="Preferencias generales de tu hogar" styleClass="muted-text"/></VBox>
    <VBox spacing="14" maxWidth="680" styleClass="content-card">
        <Label text="Datos del hogar" styleClass="section-title"/>
        <Label text="Nombre del hogar" styleClass="field-label"/><TextField promptText="Ej. Mi hogar"/>
        <Label text="Dirección" styleClass="field-label"/><TextField promptText="Dirección del hogar"/>
        <Label text="Preferencias generales" styleClass="field-label"/><TextField promptText="Preferencias"/>
        <Button text="Guardar configuración" onAction="#guardarConfiguracion" styleClass="primary-button"/>
    </VBox>
</VBox>
