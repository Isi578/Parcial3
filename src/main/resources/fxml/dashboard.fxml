<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController"
            fitToWidth="true"
            style="-fx-background-color: #f8fafc;
                   -fx-background: #f8fafc;">

    <content>
        <VBox spacing="18"
              style="-fx-background-color: #f8fafc;">

            <padding>
                <Insets top="24"
                        right="30"
                        bottom="24"
                        left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="12">

                <VBox spacing="4"
                      HBox.hgrow="ALWAYS">

                    <Label fx:id="homeNameLabel"
                           text="My Smart Home"
                           style="-fx-font-size: 24px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #0f172a;"/>

                    <Label fx:id="homeAddressLabel"
                           text="Address: Not configured"
                           wrapText="true"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #475569;"/>

                </VBox>

                <Button text="Refresh Dashboard"
                        onAction="#refreshDashboard"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

                <Button text="Clear Activity"
                        onAction="#clearSessionActivity"
                        style="-fx-background-color: #64748b;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

            </HBox>

            <Label fx:id="feedbackLabel"
                   text="Ready."
                   wrapText="true"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #047857;"/>

            <GridPane hgap="12"
                      vgap="12">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints minHeight="100"/>
                    <RowConstraints minHeight="100"/>
                </rowConstraints>

                <VBox spacing="6"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0"
                      style="-fx-background-color: white;
                             -fx-padding: 14;
                             -fx-background-radius: 8;
                             -fx-border-color: #dbeafe;
                             -fx-border-radius: 8;">

                    <Label text="Total Devices"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <Label fx:id="totalDevicesLabel"
                           text="0"
                           style="-fx-text-fill: #1d4ed8;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0"
                      style="-fx-background-color: white;
                             -fx-padding: 14;
                             -fx-background-radius: 8;
                             -fx-border-color: #dcfce7;
                             -fx-border-radius: 8;">

                    <Label text="Active Devices"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <Label fx:id="activeDevicesLabel"
                           text="0"
                           style="-fx-text-fill: #15803d;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="0"
                      style="-fx-background-color: white;
                             -fx-padding: 14;
                             -fx-background-radius: 8;
                             -fx-border-color: #fef3c7;
                             -fx-border-radius: 8;">

                    <Label text="Recorded Events"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <Label fx:id="eventCountLabel"
                           text="0"
                           style="-fx-text-fill: #b45309;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      GridPane.columnIndex="3"
                      GridPane.rowIndex="0"
                      style="-fx-background-color: white;
                             -fx-padding: 14;
                             -fx-background-radius: 8;
                             -fx-border-color: #fce7f3;
                             -fx-border-radius: 8;">

                    <Label text="Notifications"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <Label fx:id="notificationCountLabel"
                           text="0"
                           style="-fx-text-fill: #be185d;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="1"
                      style="-fx-background-color: white;
                             -fx-padding: 14;
                             -fx-background-radius: 8;
                             -fx-border-color: #ede9fe;
                             -fx-border-radius: 8;">

                    <Label text="Undo Actions"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <Label fx:id="undoCountLabel"
                           text="0"
                           style="-fx-text-fill: #7c3aed;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1"
                      style="-fx-background-color: white;
                             -fx-padding: 14;
                             -fx-background-radius: 8;
                             -fx-border-color: #cffafe;
                             -fx-border-radius: 8;">

                    <Label text="Automations"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <Label fx:id="automationCountLabel"
                           text="0"
                           style="-fx-text-fill: #0e7490;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="1"
                      style="-fx-background-color: white;
                             -fx-padding: 14;
                             -fx-background-radius: 8;
                             -fx-border-color: #ccfbf1;
                             -fx-border-radius: 8;">

                    <Label text="Mediator Executions"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <Label fx:id="mediatorExecutionCountLabel"
                           text="0"
                           style="-fx-text-fill: #0f766e;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="6"
                      GridPane.columnIndex="3"
                      GridPane.rowIndex="1"
                      style="-fx-background-color: white;
                             -fx-padding: 14;
                             -fx-background-radius: 8;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8;">

                    <Label text="Facade Summary"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <Label text="Shared"
                           style="-fx-text-fill: #334155;
                                  -fx-font-size: 22px;
                                  -fx-font-weight: bold;"/>

                </VBox>

            </GridPane>

            <Separator/>

            <GridPane hgap="16"
                      vgap="16">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="8"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0"
                      style="-fx-background-color: white;
                             -fx-padding: 16;
                             -fx-background-radius: 8;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8;">

                    <Label text="Latest Activity"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #0f172a;"/>

                    <Label fx:id="latestEventLabel"
                           text="Latest event: No events recorded."
                           wrapText="true"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #334155;"/>

                    <Label fx:id="latestNotificationLabel"
                           text="Latest notification: No notifications recorded."
                           wrapText="true"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #334155;"/>

                </VBox>

                <VBox spacing="8"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0"
                      style="-fx-background-color: white;
                             -fx-padding: 16;
                             -fx-background-radius: 8;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8;">

                    <Label text="Pattern Integration"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #0f172a;"/>

                    <Label fx:id="patternStatusLabel"
                           text="Pattern status"
                           wrapText="true"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #334155;"/>

                </VBox>

            </GridPane>

            <VBox spacing="8"
                  style="-fx-background-color: white;
                         -fx-padding: 16;
                         -fx-background-radius: 8;
                         -fx-border-color: #e2e8f0;
                         -fx-border-radius: 8;">

                <Label text="Registered Devices"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #0f172a;"/>

                <Label fx:id="deviceSummaryLabel"
                       text="No devices are registered."
                       wrapText="true"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #334155;"/>

            </VBox>

        </VBox>
    </content>

</ScrollPane>