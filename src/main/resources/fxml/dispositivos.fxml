<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DispositivosController" spacing="18" styleClass="page">
    <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12"><VBox spacing="4"><Label text="Dispositivos" styleClass="page-title"/><Label text="Administra los equipos del hogar" styleClass="muted-text"/></VBox><HBox HBox.hgrow="ALWAYS"/><Button text="+ Registrar dispositivo" onAction="#registrarDispositivo" styleClass="primary-button"/></HBox>
    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Filtrar por tipo:"/><ComboBox promptText="Todos los tipos" prefWidth="210"/><HBox HBox.hgrow="ALWAYS"/><Button text="Editar" onAction="#editarDispositivo"/><Button text="Eliminar" onAction="#eliminarDispositivo" styleClass="danger-button"/><Button text="Encender" onAction="#encenderDispositivo" styleClass="primary-button"/><Button text="Apagar" onAction="#apagarDispositivo"/></HBox>
    <TableView VBox.vgrow="ALWAYS"><columns><TableColumn text="Nombre" prefWidth="180"/><TableColumn text="Tipo" prefWidth="150"/><TableColumn text="Habitación" prefWidth="170"/><TableColumn text="Estado" prefWidth="130"/><TableColumn text="Marca / Modelo" prefWidth="220"/></columns></TableView>
</VBox>
